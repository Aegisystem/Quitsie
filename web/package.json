{
  "name": "quitsie-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "openapi-typescript ../openapi.yaml -o src/api/schema.gen.ts",
    "typecheck": "tsc -b && tsc -p e2e",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "e2e": "npm run build && go -C ../api build -o bin/quitsie ./cmd/server && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "dexie": "^4.4.6",
    "i18next": "^26.4.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
