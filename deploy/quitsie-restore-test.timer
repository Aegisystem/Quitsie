# Install as /etc/systemd/system/quitsie-restore-test.timer on the VM (provision.sh does it).
[Unit]
Description=Quitsie: test the restore of the backup every week

[Timer]
# Monday morning in the Americas, when someone can look at a failure.
OnCalendar=Mon *-*-* 13:00:00 UTC
RandomizedDelaySec=1h
# A run missed while the VM was off happens at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
