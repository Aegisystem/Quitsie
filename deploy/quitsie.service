# Install as /etc/systemd/system/quitsie.service on the VM (provision.sh does it).
[Unit]
Description=Quitsie (API + PWA)
# A fresh VM must get its database back from R2 before the app can create an
# empty one: quitsie-restore.service does that and holds the R2 credentials,
# so the app never sees them. If the restore fails, the app does not start.
Requires=quitsie-restore.service
After=network-online.target quitsie-restore.service
Wants=network-online.target

[Service]
Type=simple
User=quitsie
Group=quitsie
# Creates /var/lib/quitsie owned by the quitsie user; the database holds
# personal data, so nobody else can read it.
StateDirectory=quitsie
StateDirectoryMode=0750
WorkingDirectory=/var/lib/quitsie
UMask=0077

# Only cloudflared connects to it: no public port. Keep it that way: the server
# believes the visitor's address in CF-Connecting-IP only over loopback, so any
# other local proxy could forward forged ones (api/internal/httpapi/limits.go).
Environment=QUITSIE_ADDR=127.0.0.1:8080
Environment=QUITSIE_DB_PATH=/var/lib/quitsie/quitsie.db
# The VM has 1 GB. Past this the garbage collector works harder instead of
# letting the kernel kill the process, which would forget the limits in memory.
Environment=GOMEMLIMIT=700MiB
# The app's configuration and secrets live only on the VM. The server does not
# start until the required ones are filled in (quitsie.env.example lists them).
EnvironmentFile=/etc/quitsie/quitsie.env

# /usr/local/bin/quitsie is installed by quitsie-deploy (see deploy.yml).
ExecStart=/usr/local/bin/quitsie
Restart=on-failure
RestartSec=2
# The server finishes in-flight requests on SIGTERM (10 s at most); give it time.
TimeoutStopSec=15

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
