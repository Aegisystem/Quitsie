# Install as /etc/systemd/system/quitsie-alert@.service on the VM (provision.sh does it).
#
# A unit with OnFailure=quitsie-alert@%n.service starts it, with its own name
# as the instance, as soon as systemd marks it as failed. That is faster than
# waiting for quitsie-alert-check.timer, which also tells when the unit works
# again. Same script, same state and the same limits on emails.
[Unit]
Description=Quitsie: email the owner that %i failed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/quitsie-alert-check --failed %i
StateDirectory=quitsie-alert
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=5min

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
