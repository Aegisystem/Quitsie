# provision.sh asks for these values and writes /etc/quitsie/litestream.env (mode 600) on the VM.
# To change them by hand: sudoedit that file. Never commit the real file.
# R2 API token with Object Read & Write on the quitsie-backups bucket, and the account ID shown in R2.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
