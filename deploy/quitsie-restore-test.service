# Install as /etc/systemd/system/quitsie-restore-test.service on the VM (provision.sh does it).
#
# Started every week by quitsie-restore-test.timer, or by hand with
# `sudo systemctl start quitsie-restore-test`. It runs the restore test
# (deploy/restore-test.sh) in a private /var/tmp: it never writes the live
# database or the replica. If it fails, the owner gets an email.
[Unit]
Description=Quitsie: prove that the latest backup in R2 restores
After=network-online.target litestream.service
Wants=network-online.target
# Before the first deploy there is no database and nothing in R2 to restore.
ConditionPathExists=/var/lib/quitsie/quitsie.db
OnFailure=quitsie-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/quitsie-restore-test
TimeoutStartSec=30min
# The app keeps priority over the test on the VM's shared CPU and disk.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
