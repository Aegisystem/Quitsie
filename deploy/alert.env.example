# provision.sh writes /etc/quitsie/alert.env (mode 600) on the VM from QUITSIE_ALERT_EMAIL, which
# the first-deploy wizard passes. To change it by hand: sudoedit that file. Never commit the real file.
# Address that gets the alerts of quitsie-alert-check (deploy/alert-check.sh). Empty: they only go
# to the journal. They go out through Resend with QUITSIE_RESEND_API_KEY and QUITSIE_MAIL_FROM of
# /etc/quitsie/quitsie.env.
QUITSIE_ALERT_EMAIL=
