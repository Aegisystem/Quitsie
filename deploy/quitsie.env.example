# provision.sh creates /etc/quitsie/quitsie.env (mode 600) from this file. Uncomment and fill in
# the values with sudoedit before the first start: the server refuses to start without the ones
# marked as required. Never commit the real file. api/cmd/server/main.go documents every variable.

# Required. The app's base URL, without a trailing slash.
# QUITSIE_PUBLIC_ORIGIN=https://quitsie.app

# Required. Login codes go out through Resend; the sender's domain must be verified there.
# QUITSIE_RESEND_API_KEY=
# QUITSIE_MAIL_FROM="Quitsie <codigos@quitsie.app>"

# Required. At least 32 bytes that sign the Invite links; changing it revokes them all.
# Generate it with: openssl rand -base64 32
# QUITSIE_INVITE_SECRET=

# Optional. Without both, Google sign-in is off. The client's redirect URI in Google Cloud is
# <QUITSIE_PUBLIC_ORIGIN>/api/v1/auth/google/callback.
# QUITSIE_GOOGLE_CLIENT_ID=
# QUITSIE_GOOGLE_CLIENT_SECRET=

# Optional. PreferredCurrency of new Users until they change it (default USD).
# QUITSIE_DEFAULT_CURRENCY=USD

# QUITSIE_ENV=development and QUITSIE_MAIL=log are for running locally: they do not belong here.
